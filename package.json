{
  "name": "signaldesk",
  "version": "0.1.0",
  "private": true,
  "description": "AI-orchestrated one-page business operating system",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @signaldesk/web dev",
    "build": "pnpm --filter @signaldesk/web build",
    "lint": "eslint .",
    "audit": "pnpm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @signaldesk/persistence db:generate",
    "db:check": "pnpm --filter @signaldesk/persistence db:check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:check && pnpm build",
    "test:production": "node apps/web/scripts/production-readiness-check.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "autocannon": "8.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
