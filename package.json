{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run packages/domain packages/integrations/src/salesforce packages/integrations/src/hubspot packages/integrations/src/stripe packages/integrations/src/gmail packages/integrations/src/slack packages/integrations/src/jira packages/integrations/src/linear packages/intelligence packages/application packages/semantics packages/goals packages/dependencies packages/csv-import packages/data-quality --isolate false",
    "test:visual": "tsx scripts/runtime_visual_acceptance.ts"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.1.1",
    "@google/genai": "^2.4.0",
    "@iconify-json/logos": "^1.2.13",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "simple-icons": "^16.29.0",
    "vite": "^6.2.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
