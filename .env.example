# Application
NEXT_PUBLIC_APP_NAME=SignalDesk

# PostgreSQL — use local/sandbox credentials only. This must be the
# least-privilege app_runtime role provisioned by
# packages/persistence/sql/provision_app_role.sql, never the migration
# owner role: app_runtime has no superuser/BYPASSRLS/DELETE grants, so the
# forced RLS policies in packages/persistence/drizzle actually apply to it.
DATABASE_URL=postgres://app_runtime:change-me@localhost:5432/business_dashboard

# Supabase Auth (ADR 0005). apps/web/.env.local needs its own copy of these
# (Next.js only auto-loads env files from the app's own directory).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_change-me

# Social sign-in (docs/adr/0007-oauth-scaffolding.md). Comma-separated
# provider ids ("google", "slack_oidc", "linkedin_oidc", "facebook") — only
# add one after registering a real OAuth app with that provider AND
# entering its Client ID/Secret in the Supabase dashboard.
NEXT_PUBLIC_ENABLED_OAUTH_PROVIDERS=

# HubSpot connector (docs/adr/0008-first-real-connector-hubspot.md).
# Server-only — never NEXT_PUBLIC_. Register a real app at
# https://developers.hubspot.com/, redirect URI
# {your-origin}/integrations/hubspot/callback.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Slack connector — a second connector-style OAuth app, distinct from the
# "slack_oidc" social sign-in provider above. Server-only — never
# NEXT_PUBLIC_. Register a real app at https://api.slack.com/apps, redirect
# URI {your-origin}/integrations/slack/callback.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Salesforce connector — real OAuth 2.0 web server flow, no record sync
# yet. Server-only — never NEXT_PUBLIC_. Register a real Connected App in
# Salesforce Setup (Setup -> App Manager -> New Connected App), redirect
# URI {your-origin}/integrations/salesforce/callback, OAuth scopes must
# include "api" and "refresh_token".
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Stripe connector (Connect OAuth, Standard accounts). Server-only — never
# NEXT_PUBLIC_. Register a real app and enable OAuth at
# https://dashboard.stripe.com/settings/connect/onboarding-options/oauth,
# redirect URI {your-origin}/integrations/stripe/callback. Unlike
# HubSpot/Slack, there is no client secret — Stripe's OAuth token exchange
# and deauthorize calls authenticate with your account's own secret API
# key (sk_test_.../sk_live_...) instead.
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=

# QuickBooks Online connector. Server-only — never NEXT_PUBLIC_. Register a
# real app at https://developer.intuit.com/, redirect URI
# {your-origin}/integrations/quickbooks/callback.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Xero connector — real OAuth 2.0, real open-invoice sync (mirrors
# QuickBooks' own connector). Server-only — never NEXT_PUBLIC_. Register a
# real app at https://developer.xero.com/app/manage, redirect URI
# {your-origin}/integrations/xero/callback, scopes must include
# "offline_access" and "accounting.transactions.read".
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Jira (Atlassian) connector — real OAuth 2.0 (3LO), real open-issue sync
# (mirrors Asana's own connector). Server-only — never NEXT_PUBLIC_.
# Register a real app at https://developer.atlassian.com/console/myapps/,
# callback URL {your-origin}/integrations/jira/callback, scopes must
# include "read:jira-work" and "offline_access".
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Google connector (shared by Gmail and Google Calendar — one OAuth client
# can request scopes across both APIs and register multiple redirect
# URIs). Server-only — never NEXT_PUBLIC_. Register a real OAuth client at
# https://console.cloud.google.com/apis/credentials, enable the Gmail API
# and Calendar API, redirect URIs {your-origin}/integrations/gmail/callback
# and {your-origin}/integrations/google-calendar/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft connector (shared by Outlook and Microsoft Calendar via
# Microsoft Graph). Server-only — never NEXT_PUBLIC_. Register a real app
# at https://entra.microsoft.com/ (App registrations), grant it Mail.Read
# and Calendars.Read, redirect URIs
# {your-origin}/integrations/microsoft-outlook/callback and
# {your-origin}/integrations/microsoft-calendar/callback.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Asana connector. Server-only — never NEXT_PUBLIC_. Register a real app
# at https://app.asana.com/0/developer-console, redirect URI
# {your-origin}/integrations/asana/callback.
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# Linear connector. Server-only — never NEXT_PUBLIC_. Register a real app
# at https://linear.app/settings/api/applications/new, redirect URI
# {your-origin}/integrations/linear/callback.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Zendesk connector — real OAuth 2.0, real open-ticket sync (mirrors
# Jira's own connector). Server-only — never NEXT_PUBLIC_. Unlike every
# other connector, the subdomain is real user input at connect time, not
# a static var here — register a real OAuth client at
# https://{your-subdomain}.zendesk.com/admin/apps-integrations/apis/zendesk-api/oauth_clients,
# redirect URI {your-origin}/integrations/zendesk/callback.
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# QuickBooks webhook (real-time invoice-status updates, complements the
# QuickBooks OAuth pair above). Verifier token from
# https://developer.intuit.com/app/developer/myapps -> Webhooks. Server-only
# — never NEXT_PUBLIC_.
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=

# Agent Fabric (docs/adr/0020-agent-fabric.md). AGENT_FABRIC_ENABLED gates
# the entire feature; with it unset/false the deterministic Command Center
# is completely unaffected. ANTHROPIC_API_KEY follows the same "unset
# credential = inert" convention as every connector above — without it,
# both specialists resolve to the always-available deterministic provider,
# so the whole pipeline (parallel dispatch, reconciliation, approval,
# audit) still runs for real, at zero cost. Get a real key at
# https://console.anthropic.com/settings/keys. SIGNALDESK_ANTHROPIC_MODEL
# is a plain override (default: claude-haiku-4-5), not a kill switch.
# Server-only — never NEXT_PUBLIC_.
AGENT_FABRIC_ENABLED=
ANTHROPIC_API_KEY=
SIGNALDESK_ANTHROPIC_MODEL=

# Stripe Billing — this app charging its own customers, unrelated to the
# Stripe Connect connector above (both may reuse the same
# STRIPE_SECRET_KEY; they're separate API surfaces of one account).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is safe to expose (pk_test_.../pk_live_...),
# mounts the client-side Payment Element. STRIPE_WEBHOOK_SECRET signs
# https://dashboard.stripe.com/webhooks pointed at
# {your-origin}/billing/webhooks/stripe, events: customer.subscription.*,
# invoice.paid, invoice.payment_failed.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Morning Business Agent (apps/web/app/api/cron/morning-brief/route.ts) —
# secures the Vercel Cron target per Vercel's own documented CRON_SECRET
# convention (docs.vercel.com/cron-jobs/manage-cron-jobs#securing-cron-jobs).
# A real, random string of at least 16 characters. Vercel sends it
# automatically as the Authorization header on every cron invocation once
# both this var and apps/web/vercel.json's crons entry exist — no manual
# wiring beyond setting this value. Server-only — never NEXT_PUBLIC_.
CRON_SECRET=

# Public-launch gate (PRODUCTION-ACTIVATION-CHECKLIST.md Stage 7). Leave
# both unset/false in every non-production environment. Setting
# SIGNALDESK_PUBLIC_LAUNCH_MODE=true is the owner's explicit signal that
# real customers can sign up — the app refuses to start in that mode
# unless SIGNALDESK_LEGAL_CONTENT_REVIEWED=true is also set, so
# placeholder /legal/terms, /legal/privacy, /support content can never
# silently go live.
SIGNALDESK_PUBLIC_LAUNCH_MODE=
SIGNALDESK_LEGAL_CONTENT_REVIEWED=

# Resend — real outbound email delivery for "Email me this brief"
# (docs/adr/0041-notification-email-delivery.md). Unset ⇒ the button is
# hidden/inert with an honest error, same convention as every credential
# above. Get a real key at https://resend.com/api-keys.
# RESEND_FROM_EMAIL must be a verified sender/domain in your Resend
# account (e.g. "SignalDesk <briefs@yourdomain.com>"). Server-only —
# never NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

