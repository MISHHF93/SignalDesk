# ==============================================================================
# SignalDesk Environment Configuration (Google Cloud & Native Environment)
# ==============================================================================
# All runtime, cloud infrastructure, AI, identity, and Google-native connector
# environment variables are consolidated here. Duplicate entries, legacy keys,
# and non-Google third-party SDK dependencies have been pruned in favor of
# sovereign Google Cloud and Gemini API infrastructure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE AI STUDIO & GEMINI API (Core AI & Multimodal Intelligence)
# ------------------------------------------------------------------------------
# Injected automatically by Google AI Studio at runtime from user secrets.
# Powers brand-guarded and railguarded executive synthesis, copilot, and voice.
GEMINI_API_KEY=""

# Primary Google Gemini model identifier (gemini-3.8-flash default for low-latency reasoning)
GEMINI_MODEL="gemini-3.8-flash"

# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD RUN & INGRESS RUNTIME
# ------------------------------------------------------------------------------
# Canonical URL where this applet is hosted by Google Cloud Run.
APP_URL="https://ais-dev-62pwdxf3jegq4yodmb42gy-423433823926.us-west2.run.app"

# Ingress port assigned by the Google Cloud Run container environment (port 3000)
PORT="3000"

# Node runtime environment (development, production, test)
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD SQL (Managed Relational Database - PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string connecting to your Google Cloud SQL for PostgreSQL instance.
# When running on Cloud Run, use the Unix domain socket: /cloudsql/[GOOGLE_CLOUD_SQL_INSTANCE]
DATABASE_URL="postgresql://postgres:[PASSWORD]@127.0.0.1:5432/signaldesk?host=/cloudsql/[GOOGLE_CLOUD_SQL_INSTANCE]"

# Google Cloud Platform project ID hosting the database and services
GOOGLE_CLOUD_PROJECT="signaldesk-509121"

# Google Cloud region where the database instance is provisioned (Toronto: northamerica-northeast1)
GOOGLE_CLOUD_REGION="northamerica-northeast1"

# Google Cloud SQL instance connection name in the format: [PROJECT_ID]:[REGION]:[INSTANCE_ID]
GOOGLE_CLOUD_SQL_INSTANCE="signaldesk-509121:northamerica-northeast1:signaldesk-pg-db"

# ------------------------------------------------------------------------------
# 4. GOOGLE CLOUD STORAGE, PUB/SUB & BIGQUERY TELEMETRY
# ------------------------------------------------------------------------------
# GCS bucket used for persisting executive transcripts, exported reports, and artifacts
GOOGLE_CLOUD_STORAGE_BUCKET="signaldesk-toronto-artifacts"

# Google Cloud Pub/Sub topic name for streaming cross-system telemetry and audit events
GOOGLE_PUBSUB_TOPIC="signaldesk-events"

# Enable structured telemetry logging to Google Cloud Logging (Stackdriver)
GOOGLE_CLOUD_LOGGING_ENABLED="true"

# Google Cloud BigQuery dataset for real-time analytical business intelligence
GOOGLE_BIGQUERY_DATASET="signaldesk_analytics_lake"

# Google Cloud Key Management Service (Cloud KMS) Key Ring for hardware-backed dual-key signatures
GOOGLE_CLOUD_KMS_KEY_RING="signaldesk-gov-keyring"

# ------------------------------------------------------------------------------
# 5. GOOGLE WORKSPACE & GOOGLE IDENTITY SERVICES (OAuth 2.0 & Enterprise SSO)
# ------------------------------------------------------------------------------
# Google Cloud OAuth 2.0 Web Client ID for Google Workspace (Gmail, Calendar, Drive, Docs, Sheets)
GOOGLE_CLIENT_ID=""

# Google Cloud OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=""

# Authorized corporate Google Workspace domain for Single Sign-On (e.g. gmail.com or yourcompany.com)
GOOGLE_WORKSPACE_DOMAIN="gmail.com"

# Google Drive Root Archive Folder ID for automated executive briefings & board packs
GOOGLE_DRIVE_FOLDER_ID="1YXvwxHOUn2LnAIfqAH1xNnFx-wFej6ru"

# ------------------------------------------------------------------------------
# 6. GOOGLE MAPS PLATFORM (Geospatial, Logistics & Environmental Intelligence)
# ------------------------------------------------------------------------------
# Canonical server-side Google Maps Platform API key (proxied safely via /api/maps/*)
GOOGLE_MAPS_API_KEY=""

# Configured Google Maps Platform API Suite (35 Active Services):
# - Maps & Visuals: Maps JavaScript API, Maps Static API, Maps Embed API, Map Tiles API,
#   Map Management API, Maps 3D SDK, Aerial View API, Street View Static & Publish
# - Places & Addressing: Places API (New), Places API, Places UI Kit, Places Aggregate API,
#   Address Validation API, Geocoding API, Geolocation API, Time Zone API
# - Routes & Logistics: Routes API, Directions API, Distance Matrix API, Route Optimization API,
#   Isochrones API, Roads API, Navigation Connect API, Navigation SDK
# - Environmental: Air Quality API (AQI), Weather API, Pollen API, Solar API
# - Grounding & Spatial Data: Maps Grounding Lite, Maps Datasets API, Maps Elevation API

# ------------------------------------------------------------------------------
# 7. GOOGLE PAY & STRIPE REVENUE RECONCILIATION GATEWAY
# ------------------------------------------------------------------------------
# Google Pay Merchant ID for instant verified digital receipts & settlement
GOOGLE_PAY_MERCHANT_ID=""

# Google Cloud Billing Account ID for automated infrastructure cost monitoring & capping
GOOGLE_CLOUD_BILLING_ACCOUNT_ID=""

# Stripe (Billing, Invoicing, Subscriptions, Ledger reconciliation)
STRIPE_CLIENT_ID=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 8. THIRD-PARTY ENTERPRISE CONNECTORS (Optional Provider Credentials)
# ------------------------------------------------------------------------------
# Salesforce Enterprise CRM (OAuth 2.0)
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""

# QuickBooks Enterprise Accounting (OAuth 2.0)
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""

# GitHub Enterprise (Personal Access Token / GitHub App Token)
GITHUB_TOKEN=""

# HubSpot CRM (Private App Access Token)
HUBSPOT_ACCESS_TOKEN=""

# Linear Project Velocity (API Key)
LINEAR_API_KEY=""

# Zendesk Support (Subdomain + API Token)
ZENDESK_SUBDOMAIN=""
ZENDESK_API_TOKEN=""

# Slack Enterprise Grid (Bot Token + Signing Secret)
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""

# Atlassian Jira (Host + API Token)
JIRA_HOST=""
JIRA_API_TOKEN=""

# Asana Project Management (Personal Access Token)
ASANA_ACCESS_TOKEN=""

# Resend Transactional Email (API Key)
RESEND_API_KEY=""

# Xero Cloud Accounting (OAuth 2.0)
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 9. SECURITY, VAULT & AUTOMATION
# ------------------------------------------------------------------------------
# Master key or salt for AES-256-GCM hardware vault (falls back to GEMINI_API_KEY derivation if unset)
APP_SECRET=""

# Secret token securing scheduled background automation routes
CRON_SECRET=""
