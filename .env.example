# Application
NEXT_PUBLIC_APP_NAME=SignalDesk

# PostgreSQL — use local/sandbox credentials only. This must be the
# least-privilege app_runtime role provisioned by
# packages/persistence/sql/provision_app_role.sql, never the migration
# owner role: app_runtime has no superuser/BYPASSRLS/DELETE grants, so the
# forced RLS policies in packages/persistence/drizzle actually apply to it.
DATABASE_URL=postgres://app_runtime:change-me@localhost:5432/business_dashboard

# Supabase Auth (ADR 0005). apps/web/.env.local needs its own copy of these
# (Next.js only auto-loads env files from the app's own directory).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_change-me

# Social sign-in (docs/adr/0007-oauth-scaffolding.md). Comma-separated
# provider ids ("google", "slack_oidc", "linkedin_oidc", "facebook") — only
# add one after registering a real OAuth app with that provider AND
# entering its Client ID/Secret in the Supabase dashboard.
NEXT_PUBLIC_ENABLED_OAUTH_PROVIDERS=

# HubSpot connector (docs/adr/0008-first-real-connector-hubspot.md).
# Server-only — never NEXT_PUBLIC_. Register a real app at
# https://developers.hubspot.com/, redirect URI
# {your-origin}/integrations/hubspot/callback.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Slack connector — a second connector-style OAuth app, distinct from the
# "slack_oidc" social sign-in provider above. Server-only — never
# NEXT_PUBLIC_. Register a real app at https://api.slack.com/apps, redirect
# URI {your-origin}/integrations/slack/callback.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Stripe connector (Connect OAuth, Standard accounts). Server-only — never
# NEXT_PUBLIC_. Register a real app and enable OAuth at
# https://dashboard.stripe.com/settings/connect/onboarding-options/oauth,
# redirect URI {your-origin}/integrations/stripe/callback. Unlike
# HubSpot/Slack, there is no client secret — Stripe's OAuth token exchange
# and deauthorize calls authenticate with your account's own secret API
# key (sk_test_.../sk_live_...) instead.
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=

# QuickBooks Online connector. Server-only — never NEXT_PUBLIC_. Register a
# real app at https://developer.intuit.com/, redirect URI
# {your-origin}/integrations/quickbooks/callback.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Google connector (shared by Gmail and Google Calendar — one OAuth client
# can request scopes across both APIs and register multiple redirect
# URIs). Server-only — never NEXT_PUBLIC_. Register a real OAuth client at
# https://console.cloud.google.com/apis/credentials, enable the Gmail API
# and Calendar API, redirect URIs {your-origin}/integrations/gmail/callback
# and {your-origin}/integrations/google-calendar/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft connector (shared by Outlook and Microsoft Calendar via
# Microsoft Graph). Server-only — never NEXT_PUBLIC_. Register a real app
# at https://entra.microsoft.com/ (App registrations), grant it Mail.Read
# and Calendars.Read, redirect URIs
# {your-origin}/integrations/microsoft-outlook/callback and
# {your-origin}/integrations/microsoft-calendar/callback.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Asana connector. Server-only — never NEXT_PUBLIC_. Register a real app
# at https://app.asana.com/0/developer-console, redirect URI
# {your-origin}/integrations/asana/callback.
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# Linear connector. Server-only — never NEXT_PUBLIC_. Register a real app
# at https://linear.app/settings/api/applications/new, redirect URI
# {your-origin}/integrations/linear/callback.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Stripe Billing — this app charging its own customers, unrelated to the
# Stripe Connect connector above (both may reuse the same
# STRIPE_SECRET_KEY; they're separate API surfaces of one account).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is safe to expose (pk_test_.../pk_live_...),
# mounts the client-side Payment Element. STRIPE_WEBHOOK_SECRET signs
# https://dashboard.stripe.com/webhooks pointed at
# {your-origin}/billing/webhooks/stripe, events: customer.subscription.*,
# invoice.paid, invoice.payment_failed.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

